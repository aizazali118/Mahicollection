# PostgreSQL connection string from Prisma Postgres, Neon, Supabase, or another provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Use a long random value in production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Public site URL used for password reset links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional email delivery: Resend API key.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Optional. Required only for uploading images from the admin panel to Vercel Blob.
BLOB_READ_WRITE_TOKEN=""

# Set to true only for a temporary read-only storefront preview without a database.
DEMO_MODE="false"

# Seeded demo admin. Change before production.
SEED_ADMIN_USERNAME="mahiadmin"
SEED_ADMIN_EMAIL="admin@mahicollection.pk"
SEED_ADMIN_PASSWORD="mahi@1217"
